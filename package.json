{
  "name": "peekly-mcp",
  "version": "0.1.5",
  "description": "Peekly MCP server: browser automation, sitemap crawling, PPT report generation, and credential tools for Claude Code / Codex QA workflows",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "bin": {
    "peekly-mcp": "dist/index.js",
    "peekly": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.mkdirSync('dist/report',{recursive:true});fs.copyFileSync('src/report/pptx_tool.py','dist/report/pptx_tool.py')\"",
    "prepare": "npm run build",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "release": "commit-and-tag-version"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "keytar": "^7.9.0",
    "playwright": "^1.48.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "commit-and-tag-version": "^12.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
